{
  "name": "pitaro-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "dev1": "tsx src/main.ts",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node build/main.js",
    "watch": "nodemon --exec npm run dev --watch src --ext ts"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@discordx/importer": "^1.3.3",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "3.0.0-beta.4",
    "discord.js": "^14.22.1",
    "discordx": "^11.13.2",
    "ffmpeg-static": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "winston": "^3.19.0",
    "youtube-dl-exec": "^3.1.6",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@discordjs/opus",
      "esbuild",
      "ffmpeg-static",
      "youtube-dl-exec"
    ]
  }
}
